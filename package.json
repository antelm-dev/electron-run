{
  "name": "rollup-plugin-electron-run",
  "version": "0.1.1",
  "description": "Rollup plugin and runner that live-reloads Electron on rebuild, with interactive restart controls.",
  "keywords": [
    "electron",
    "hmr",
    "live-reload",
    "restart",
    "rollup",
    "rollup-plugin",
    "typescript",
    "watch"
  ],
  "homepage": "https://github.com/antelm-dev/electron-run#readme",
  "bugs": "https://github.com/antelm-dev/electron-run/issues",
  "license": "MIT",
  "author": "Adel Terki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antelm-dev/electron-run.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rollup-plugin": {
      "types": "./dist/rollup-plugin.d.ts",
      "import": "./dist/rollup-plugin.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:lifecycle": "vitest run --config vitest.lifecycle.config.ts",
    "test:watch": "vitest",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.72.0",
    "publint": "0.3.23",
    "rollup": "^4.17.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "electron": ">=20.0.0",
    "rollup": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
